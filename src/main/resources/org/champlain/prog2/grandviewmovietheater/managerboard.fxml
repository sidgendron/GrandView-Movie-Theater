<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="650.0" spacing="0" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1">


    <HBox alignment="CENTER_LEFT" prefHeight="75" spacing="12" style="-fx-background-color: #171717;">

        <padding>
            <Insets left="20" right="20" />
        </padding>

        <ImageView fitHeight="55.0" fitWidth="65.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@Images/logo.png" />
            </image>
        </ImageView>

        <Label text="GrandView Theatre" textFill="WHITE">
            <font>
                <Font name="Bernard MT Condensed" size="35.0" />
            </font>
        </Label>

        <Region HBox.hgrow="ALWAYS" />

        <Label style="-fx-font-weight: bold;" text="MANAGER" textFill="WHITE" />

    </HBox>


    <VBox alignment="TOP_CENTER" spacing="22" style="-fx-background-color: #F7F7F7;" VBox.vgrow="ALWAYS">

        <padding>
            <Insets bottom="25" left="35" right="35" top="35" />
        </padding>

        <Label style="-fx-font-size: 27px;                       -fx-font-weight: bold;                       -fx-text-fill: #171717;" text="Manager Dashboard" />

        <Label style="-fx-font-size: 14px;                       -fx-text-fill: #777777;" text="Welcome to the management section." />

        <VBox maxWidth="450" spacing="15">


            <VBox spacing="8" style="-fx-background-color: white;                          -fx-border-color: #DDDDDD;                          -fx-background-radius: 8;                          -fx-border-radius: 8;">

                <padding>
                    <Insets bottom="18" left="20" right="20" top="18" />
                </padding>

                <Label style="-fx-font-size: 18px;                               -fx-font-weight: bold;                               -fx-text-fill: #171717;" text="Manage Movies" />

                <Label style="-fx-text-fill: #777777;" text="Display, add and update the movie list." />

                <Button fx:id="manageMoviesButton" maxWidth="Infinity" prefHeight="40" style="-fx-background-color: #811F32;                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-background-radius: 5;" text="Manage Movies" />

            </VBox>


            <VBox spacing="8" style="-fx-background-color: white;                          -fx-border-color: #DDDDDD;                          -fx-background-radius: 8;                          -fx-border-radius: 8;">

                <padding>
                    <Insets bottom="18" left="20" right="20" top="18" />
                </padding>

                <Label style="-fx-font-size: 18px;                               -fx-font-weight: bold;                               -fx-text-fill: #171717;" text="Schedule Screenings" />

                <Label style="-fx-text-fill: #777777;" text="Choose the movie, date, time and screening room." />

                <Button fx:id="scheduleShowtimeButton" maxWidth="Infinity" prefHeight="40" style="-fx-background-color: #811F32;                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-background-radius: 5;" text="Schedule Screenings" />

            </VBox>

        </VBox>

        <Button fx:id="logoutButton" prefHeight="38" prefWidth="130" style="-fx-background-color: #171717;                 -fx-text-fill: white; -fx-border-color: #171717; -fx-border-radius: 5; -fx-background-radius: 5;" text="Log Out" />

    </VBox>

</VBox>
