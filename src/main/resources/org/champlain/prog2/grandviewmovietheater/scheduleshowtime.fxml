<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="650.0" spacing="0" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1">


    <HBox alignment="CENTER_LEFT" prefHeight="112.0" prefWidth="650.0" spacing="12" style="-fx-background-color: #171717;">

        <padding>
            <Insets left="20" right="20" />
        </padding>

        <ImageView fitHeight="40.0" fitWidth="74.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@Images/logo.png" />
            </image>
        </ImageView>

        <Label text="GrandView Theatre" textFill="WHITE">
            <font>
                <Font name="Bernard MT Condensed" size="35.0" />
            </font>
        </Label>

        <Region HBox.hgrow="ALWAYS" />

        <Label text="MANAGER" textFill="WHITE">
            <font>
                <Font name="Britannic Bold" size="12.0" />
            </font>
        </Label>

    </HBox>


    <VBox alignment="TOP_CENTER" spacing="18" style="-fx-background-color: #F7F7F7;" VBox.vgrow="ALWAYS">

        <padding>
            <Insets bottom="20" left="30" right="30" top="30" />
        </padding>

        <Label style="-fx-font-size: 25px; -fx-font-weight: bold;" text="Schedule a Screening" />

        <Label style="-fx-font-size: 13px; -fx-text-fill: #666666;" text="Select a movie, date, time and screening room." />


        <VBox maxWidth="460" spacing="12" style="-fx-background-color: white;                      -fx-background-radius: 8;                      -fx-border-color: #DDDDDD;                      -fx-border-radius: 8;">

            <padding>
                <Insets bottom="20" left="25" right="25" top="20" />
            </padding>

            <Label text="com.example.movietheatre.Movie" />

            <ComboBox fx:id="movieComboBox" maxWidth="Infinity" prefHeight="38" promptText="Select a movie" />

            <Label text="Screening Date" />

            <DatePicker fx:id="datePicker" maxWidth="Infinity" prefHeight="38" promptText="Choose a date" />

            <Label text="Showtime" />

            <ComboBox fx:id="timeComboBox" maxWidth="Infinity" prefHeight="38" promptText="Select a time" />

            <Label text="Screening Room" />

            <ComboBox fx:id="roomComboBox" maxWidth="Infinity" prefHeight="38" promptText="Select a screening room" />

            <Button maxWidth="Infinity" prefHeight="42" style="-fx-background-color: #811F32;                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 5;" text="Schedule Screening" />

        </VBox>

        <Label style="-fx-font-size: 11px; -fx-text-fill: #777777;" text="All scheduled showtimes will be available to customers." />

    </VBox>

</VBox>
